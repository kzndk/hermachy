+// Match the pinned Hermes registry for calls without gateway-supplied labels.
+const TOOL_EMOJIS = new Map([
+  ['browser_back', '◀️'],
+  ['browser_click', '👆'],
+  ['browser_console', '🖥️'],
+  ['browser_get_images', '🖼️'],
+  ['browser_press', '⌨️'],
+  ['browser_scroll', '📜'],
+  ['browser_snapshot', '📸'],
+  ['browser_type', '⌨️'],
+  ['browser_vision', '👁️'],
+  ['clarify', '❓'],
+  ['cronjob', '⏰'],
+  ['delegate_task', '🔀'],
+  ['execute_code', '🐍'],
+  ['image_generate', '🎨'],
+  ['memory', '🧠'],
+  ['patch', '🔧'],
+  ['process', '⚙️'],
+  ['read_file', '📖'],
+  ['search_files', '🔎'],
+  ['skill_manage', '📝'],
+  ['terminal', '💻'],
+  ['todo', '📋'],
+  ['tool_describe', '📖'],
+  ['tool_search', '🔎'],
+  ['vision_analyze', '👁️'],
+  ['web_extract', '📄'],
+  ['web_search', '🔍'],
+  ['write_file', '✍️']
+])
+
+const TOOL_FAMILY_EMOJIS = [
+  ['browser_', '🌐'],
+  ['skill_', '📚'],
+  ['skills_', '📚'],
+  ['mcp_', '🔌']
+] as const
+
+export const toolEmoji = (name: string): string =>
+  TOOL_EMOJIS.get(name) ?? TOOL_FAMILY_EMOJIS.find(([prefix]) => name.startsWith(prefix))?.[1] ?? '⚡'
