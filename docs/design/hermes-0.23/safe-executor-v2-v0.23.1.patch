@@ -0,0 +1,182 @@
+"""Protected Hermachy sessions keep all workspace and execution routing on the workstation."""
+import os
+import pytest
+from tui_gateway import server as gateway
+
+
+@pytest.fixture
+def server():
+    methods = dict(gateway._methods)
+    yield gateway
+    gateway._methods.clear()
+    gateway._methods.update(methods)
+
+
+@pytest.mark.parametrize(
+    "method",
+    [
+        "shell.exec",
+        "cli.exec",
+        "clipboard.paste",
+        "image.attach",
+        "file.attach",
+        "pdf.attach",
+        "image.render",
+        "vault.preview.fill",
+        "input.detect_drop",
+        "profiles.list",
+        "profiles.create",
+    ],
+)
+def test_hermachy_rejects_remote_host_capability_rpcs(server, monkeypatch, method):
+    called = []
+    monkeypatch.setenv("HERMACHY_REQUIRE_SAFE_EXECUTOR", "1")
+    server._methods[method] = lambda rid, params: called.append((rid, params))
+
+    response = server.handle_request({"id": "hermachy", "method": method, "params": {}})
+
+    assert response["error"]["code"] == 4035
+    assert "unavailable in Hermachy mode" in response["error"]["message"]
+    assert called == []
+
+
+
+def test_hermachy_rejects_cross_profile_rpc_params(server, monkeypatch):
+    called = []
+    monkeypatch.setenv("HERMACHY_REQUIRE_SAFE_EXECUTOR", "1")
+    server._methods["session.resume"] = lambda rid, params: called.append((rid, params))
+
+    response = server.handle_request(
+        {
+            "id": "hermachy-profile",
+            "method": "session.resume",
+            "params": {"session_id": "stored", "profile": "other"},
+        }
+    )
+
+    assert response["error"]["code"] == 4035
+    assert "pinned to the default profile" in response["error"]["message"]
+    assert called == []
+
+
+
+def test_non_hermachy_rpc_dispatch_is_unchanged(server, monkeypatch):
+    monkeypatch.delenv("HERMACHY_REQUIRE_SAFE_EXECUTOR", raising=False)
+    server._methods["shell.exec"] = lambda rid, params: server._ok(
+        rid, {"stdout": params["command"], "stderr": "", "code": 0}
+    )
+
+    response = server.handle_request(
+        {"id": "normal", "method": "shell.exec", "params": {"command": "pwd"}}
+    )
+
+    assert response["result"] == {"stdout": "pwd", "stderr": "", "code": 0}
+
+
+
+def test_hermachy_rejects_exec_quick_command_before_subprocess(server, monkeypatch):
+    monkeypatch.setenv("HERMACHY_REQUIRE_SAFE_EXECUTOR", "1")
+    monkeypatch.setattr(
+        server,
+        "_load_cfg",
+        lambda: {"quick_commands": {"host-command": {"type": "exec", "command": "pwd"}}},
+    )
+    monkeypatch.setattr(
+        server.subprocess,
+        "run",
+        lambda *args, **kwargs: pytest.fail("quick command must not run remotely"),
+    )
+
+    response = server._methods["command.dispatch"](
+        "quick", {"name": "host-command", "arg": "", "session_id": ""}
+    )
+
+    assert response["error"]["code"] == 4035
+    assert "quick commands are unavailable in Hermachy mode" in response["error"]["message"]
+
+
+def _set_hermachy_tui_route(tmp_path, monkeypatch):
+    key = tmp_path / "hermachy-key"
+    key.write_text("private-key-placeholder", encoding="utf-8")
+    key.chmod(0o600)
+    values = {
+        "HERMACHY_REQUIRE_SAFE_EXECUTOR": "1",
+        "TERMINAL_ENV": "ssh",
+        "TERMINAL_CWD": "/home/beta/project",
+        "TERMINAL_SSH_HOST": "omarchy.example.ts.net",
+        "TERMINAL_SSH_USER": "beta",
+        "TERMINAL_SSH_PORT": "22",
+        "TERMINAL_SSH_KEY": str(key),
+        "TERMINAL_SSH_PERSISTENT": "true",
+        "TERMINAL_SYNC_REMOTE_STATE": "false",
+    }
+    for name, value in values.items():
+        monkeypatch.setenv(name, value)
+    return values
+
+
+def test_hermachy_tui_cwd_ignores_brain_config_and_client_cwd(tmp_path, monkeypatch, server):
+    values = _set_hermachy_tui_route(tmp_path, monkeypatch)
+    monkeypatch.setattr(
+        server, "_launch_configured_cwd", lambda: "/Users/brain/configured"
+    )
+
+    assert server._default_session_cwd() == values["TERMINAL_CWD"]
+    assert (
+        server._completion_cwd({"cwd": "/Users/brain/session"})
+        == values["TERMINAL_CWD"]
+    )
+
+
+def test_hermachy_resume_cwd_ignores_stored_brain_path(tmp_path, monkeypatch, server):
+    values = _set_hermachy_tui_route(tmp_path, monkeypatch)
+
+    assert (
+        server._resume_session_cwd("/Users/brain/stored-project", None)
+        == values["TERMINAL_CWD"]
+    )
+
+
+def test_hermachy_terminal_task_cwd_ignores_explicit_session_path(tmp_path, monkeypatch, server):
+    values = _set_hermachy_tui_route(tmp_path, monkeypatch)
+    local = tmp_path / "studio-project"
+    local.mkdir()
+
+    assert server._terminal_task_cwd_with_source(
+        {"cwd": str(local), "explicit_cwd": True}
+    ) == (values["TERMINAL_CWD"], "process")
+
+
+def test_hermachy_session_cwd_change_cannot_replace_client_route(tmp_path, monkeypatch, server):
+    values = _set_hermachy_tui_route(tmp_path, monkeypatch)
+    local = tmp_path / "studio-project"
+    local.mkdir()
+    session = {"session_key": "hermachy-session", "cwd": values["TERMINAL_CWD"]}
+
+    with pytest.raises(ValueError, match="pinned by the Hermachy client"):
+        server._set_session_cwd(session, str(local))
+
+    assert session["cwd"] == values["TERMINAL_CWD"]
+
+
+def test_hermachy_config_set_cwd_cannot_persist_or_replace_client_route(
+    tmp_path, monkeypatch, server
+):
+    values = _set_hermachy_tui_route(tmp_path, monkeypatch)
+    local = tmp_path / "studio-project"
+    local.mkdir()
+    writes = []
+    monkeypatch.setattr(server, "_write_config_key", lambda *args: writes.append(args))
+
+    response = server.handle_request(
+        {
+            "id": "hermachy-cwd",
+            "method": "config.set",
+            "params": {"key": "terminal.cwd", "value": str(local)},
+        }
+    )
+
+    assert response["error"]["code"] == 4002
+    assert "pinned by the Hermachy client" in response["error"]["message"]
+    assert os.environ["TERMINAL_CWD"] == values["TERMINAL_CWD"]
+    assert writes == []
