+
+import pytest
+
+from tools.environments import ssh as ssh_env
+from tools.environments.ssh import SSHEnvironment
+from tools import terminal_tool
+
+
+_HERMACHY_NAMES = (
+    "HERMACHY_REQUIRE_SAFE_EXECUTOR",
+    "TERMINAL_ENV",
+    "TERMINAL_CWD",
+    "TERMINAL_SSH_HOST",
+    "TERMINAL_SSH_USER",
+    "TERMINAL_SSH_PORT",
+    "TERMINAL_SSH_KEY",
