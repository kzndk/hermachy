+"""Closing a Hermachy client flushes sessions even with a stuck startup worker."""
+
+import os
+import subprocess
+import sys
+
+import pytest
+
+
+@pytest.mark.platforms("posix")
+def test_protected_eof_flushes_sessions_and_stops_startup_workers(tmp_path):
+    key = tmp_path / "ssh-key"
+    key.write_text("placeholder", encoding="utf-8")
+    key.chmod(0o600)
+    marker = tmp_path / "flushed"
+    env = dict(os.environ, HERMACHY_REQUIRE_SAFE_EXECUTOR="1",
+               TERMINAL_ENV="ssh", TERMINAL_CWD="/workstation",
+               TERMINAL_SSH_HOST="workstation.invalid", TERMINAL_SSH_USER="user",
+               TERMINAL_SSH_PORT="22", TERMINAL_SSH_KEY=str(key),
+               TERMINAL_SSH_PERSISTENT="true", TERMINAL_SYNC_REMOTE_STATE="false",
+               HERMES_TUI_GATEWAY_SHUTDOWN_GRACE_S="0.2")
+    script = """
+import runpy, sys, threading
+from pathlib import Path
+from tui_gateway import server
+from hermes_cli import model_switch_providers
+server._shutdown_sessions = lambda: Path(sys.argv[1]).write_text('flushed')
+def prewarm():
+    threading.Thread(target=threading.Event().wait, daemon=False).start()
+model_switch_providers.prewarm_picker_cache_async = prewarm
+runpy.run_module('tui_gateway.entry', run_name='__main__')
+"""
+    result = subprocess.run([sys.executable, "-c", script, str(marker)], input="",
+                            capture_output=True, text=True, timeout=10, env=env, check=False)
+    assert result.returncode == 0, result.stderr
+    assert "gateway.ready" in result.stdout
+    assert marker.read_text() == "flushed"
