@@ -0,0 +1,449 @@
+"""SSH boundary tests for Hermachy safe-executor mode."""
+
+from __future__ import annotations
+
+import json
+import stat
+import subprocess
+import tempfile
+from pathlib import Path
+from unittest.mock import MagicMock
+
+import pytest
+
+from tools.environments import ssh as ssh_env
+from tools.environments.ssh import SSHEnvironment
+import tools.terminal_tool as terminal_tool
+
+
+_HERMACHY_NAMES = (
+    "HERMACHY_REQUIRE_SAFE_EXECUTOR",
+    "TERMINAL_ENV",
+    "TERMINAL_CWD",
+    "TERMINAL_SSH_HOST",
+    "TERMINAL_SSH_USER",
+    "TERMINAL_SSH_PORT",
+    "TERMINAL_SSH_KEY",
+    "TERMINAL_SSH_PERSISTENT",
+    "TERMINAL_SYNC_REMOTE_STATE",
+)
+
+
+@pytest.fixture(autouse=True)
+def _clean_hermachy_env(monkeypatch):
+    for name in _HERMACHY_NAMES:
+        monkeypatch.delenv(name, raising=False)
+    yield
+
+
+def _set_hermachy_env(tmp_path, monkeypatch):
+    tmp_path.mkdir(parents=True, exist_ok=True)
+    key = tmp_path / "hermachy-key"
+    key.write_text("private-key-placeholder", encoding="utf-8")
+    key.chmod(0o600)
+    values = {
+        "HERMACHY_REQUIRE_SAFE_EXECUTOR": "1",
+        "TERMINAL_ENV": "ssh",
+        "TERMINAL_CWD": "/home/beta/project",
+        "TERMINAL_SSH_HOST": "omarchy.example.ts.net",
+        "TERMINAL_SSH_USER": "beta",
+        "TERMINAL_SSH_PORT": "22",
+        "TERMINAL_SSH_KEY": str(key),
+        "TERMINAL_SSH_PERSISTENT": "true",
+        "TERMINAL_SYNC_REMOTE_STATE": "false",
+    }
+    for name, value in values.items():
+        monkeypatch.setenv(name, value)
+    return values
+
+
+def _patch_remote_bootstrap(monkeypatch):
+    monkeypatch.setattr(ssh_env, "_SSH_MULTIPLEX", True)
+    monkeypatch.setattr(ssh_env, "_ensure_ssh_available", lambda: None)
+    monkeypatch.setattr(SSHEnvironment, "_establish_connection", lambda self: None)
+    monkeypatch.setattr(
+        SSHEnvironment, "_detect_remote_home", lambda self: "/home/beta"
+    )
+    monkeypatch.setattr(SSHEnvironment, "init_session", lambda self: None)
+
+
+def _build_hermachy_environment(tmp_path, monkeypatch):
+    values = _set_hermachy_env(tmp_path, monkeypatch)
+    _patch_remote_bootstrap(monkeypatch)
+    return SSHEnvironment(
+        host=values["TERMINAL_SSH_HOST"],
+        user=values["TERMINAL_SSH_USER"],
+        port=22,
+        key_path=values["TERMINAL_SSH_KEY"],
+        cwd=values["TERMINAL_CWD"],
+        sync_remote_state=False,
+        hermachy_safe_executor=True,
+    )
+
+
+def test_exports_completed_capability_version():
+    assert ssh_env.HERMACHY_CONTROL_VERSION == "2"
+
+
+def test_hermachy_constructor_skips_all_remote_state_setup(tmp_path, monkeypatch):
+    values = _set_hermachy_env(tmp_path, monkeypatch)
+    _patch_remote_bootstrap(monkeypatch)
+    monkeypatch.setattr(
+        SSHEnvironment,
+        "_detect_remote_home",
+        lambda self: pytest.fail("Hermachy must not detect a sync destination"),
+    )
+    monkeypatch.setattr(
+        SSHEnvironment,
+        "_ensure_remote_dirs",
+        lambda self: pytest.fail("Hermachy must not create remote .hermes directories"),
+    )
+    monkeypatch.setattr(
+        ssh_env,
+        "FileSyncManager",
+        lambda **kwargs: pytest.fail("Hermachy must not construct FileSyncManager"),
+    )
+
+    env = SSHEnvironment(
+        host=values["TERMINAL_SSH_HOST"],
+        user=values["TERMINAL_SSH_USER"],
+        port=22,
+        key_path=values["TERMINAL_SSH_KEY"],
+        cwd=values["TERMINAL_CWD"],
+        sync_remote_state=False,
+        hermachy_safe_executor=True,
+    )
+    try:
+        assert env._sync_manager is None
+        env._before_execute()
+    finally:
+        env.cleanup()
+
+
+def test_hermachy_ssh_argv_disables_ambient_identity_and_forwarding(
+    tmp_path, monkeypatch
+):
+    env = _build_hermachy_environment(tmp_path, monkeypatch)
+    try:
+        command = env._build_ssh_command()
+        assert "IdentitiesOnly=yes" in command
+        assert "IdentityAgent=none" in command
+        assert "ClearAllForwardings=yes" in command
+        assert "-F" in command
+        assert command[command.index("-F") + 1] == "/dev/null"
+        assert "-T" in command
+        assert "PreferredAuthentications=publickey" in command
+        assert "PubkeyAuthentication=yes" in command
+        assert "PasswordAuthentication=no" in command
+        assert "KbdInteractiveAuthentication=no" in command
+        assert "GSSAPIAuthentication=no" in command
+        assert "ForwardAgent=no" in command
+        assert "ForwardX11=no" in command
+        assert "StrictHostKeyChecking=yes" in command
+        assert "StrictHostKeyChecking=accept-new" not in command
+        assert command[command.index("-i") + 1] == str(tmp_path / "hermachy-key")
+    finally:
+        env.cleanup()
+
+
+def test_hermachy_scp_uses_same_identity_restrictions(tmp_path, monkeypatch):
+    env = _build_hermachy_environment(tmp_path, monkeypatch)
+    source = tmp_path / "source.txt"
+    source.write_text("data", encoding="utf-8")
+    calls = []
+
+    def capture(command, **kwargs):
+        calls.append(command)
+        return subprocess.CompletedProcess(command, 0, stdout="", stderr="")
+
+    monkeypatch.setattr(subprocess, "run", capture)
+    try:
+        env._scp_upload(str(source), "/home/beta/source.txt")
+    finally:
+        env.cleanup()
+
+    scp = next(command for command in calls if command[0] == "scp")
+    assert "IdentitiesOnly=yes" in scp
+    assert "IdentityAgent=none" in scp
+    assert "ClearAllForwardings=yes" in scp
+    assert "-F" in scp
+    assert scp[scp.index("-F") + 1] == "/dev/null"
