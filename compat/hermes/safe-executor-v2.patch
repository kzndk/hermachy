index 0000000000000000000000000000000000000000..abccc8c1f8e8eafbb024e529906df6acc8d05eec
--- /dev/null
+++ i/tests/gateway/test_hermachy_executor_bridge.py
@@ -0,0 +1,56 @@
+"""Exercise the real gateway import used by the TUI with a private profile."""
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+import pytest
+
+
+@pytest.mark.parametrize("linked", [True, False])
+def test_gateway_import_preserves_launcher_route_only_for_hermachy(tmp_path, linked):
+    home = tmp_path / "home"
+    profile = home / ".hermes"
+    profile.mkdir(parents=True)
+    (profile / "config.yaml").write_text(
+        "terminal:\n  backend: local\n  cwd: /wrong-host-directory\n"
+        "  ssh_host: wrong-host\n  ssh_user: wrong-user\n"
+        "  ssh_port: 2222\n  ssh_key: /wrong-key\n  timeout: 43\n"
+    )
+    key = tmp_path / "executor-key"
+    key.write_text("test-key")
+    key.chmod(0o600)
+    route = {
+        "TERMINAL_ENV": "ssh",
+        "TERMINAL_CWD": "/home/omarchy/project",
+        "TERMINAL_SSH_HOST": "omarchy.example.ts.net",
+        "TERMINAL_SSH_USER": "omarchy",
+        "TERMINAL_SSH_PORT": "22",
+        "TERMINAL_SSH_KEY": str(key),
+        "TERMINAL_SSH_PERSISTENT": "true",
+        "TERMINAL_SYNC_REMOTE_STATE": "false",
+    }
+    env = dict(os.environ, HOME=str(home), HERMES_HOME=str(profile), **route)
+    env.pop("HERMACHY_REQUIRE_SAFE_EXECUTOR", None)
+    if linked:
+        env["HERMACHY_REQUIRE_SAFE_EXECUTOR"] = "1"
+    root = Path(__file__).resolve().parents[2]
+    env["PYTHONPATH"] = str(root)
+    completed = subprocess.run(
+        [sys.executable, "-c", "import json,os; import gateway.run; "
+         "print('ROUTE=' + json.dumps({k:v for k,v in os.environ.items() "
+         "if k.startswith('TERMINAL_') or k.startswith('HERMACHY_')}))"],
+        cwd=tmp_path, env=env, capture_output=True, text=True, timeout=60,
+    )
+    assert completed.returncode == 0, completed.stderr
+    actual = json.loads(next(line[6:] for line in completed.stdout.splitlines()
+                             if line.startswith("ROUTE=")))
+    if linked:
+        assert {name: actual.get(name) for name in route} == route
+        assert actual["HERMACHY_REQUIRE_SAFE_EXECUTOR"] == "1"
+    else:
+        assert actual["TERMINAL_ENV"] == "local"
+        assert actual["TERMINAL_CWD"] == "/wrong-host-directory"
+        assert actual["TERMINAL_SSH_HOST"] == "wrong-host"
+    assert actual["TERMINAL_TIMEOUT"] == "43"
