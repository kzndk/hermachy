diff --git a/hermes_cli/safe_executor.py b/hermes_cli/safe_executor.py
new file mode 100644
index 0000000000000000000000000000000000000000..a694738606c0ac2b226fc7f9f6751911210a5e0b
--- /dev/null
+++ b/hermes_cli/safe_executor.py
@@ -0,0 +1,181 @@
+"""Fail-closed process contract for Hermachy remote execution.
+
+This module is intentionally dependency-light because dotenv, legacy CLI,
+TUI-child, and terminal-tool bootstrap paths all need the same authority.
+Normal Hermes launches are unchanged unless HERMACHY_REQUIRE_SAFE_EXECUTOR=1 is
+already present in the inherited process environment.
+"""
+
+from __future__ import annotations
+
+import os
+import stat
+from pathlib import Path
+from typing import Mapping, MutableMapping
+
+HERMACHY_CONTROL_VERSION = "2"
+HERMACHY_GUARD = "HERMACHY_REQUIRE_SAFE_EXECUTOR"
+PROTECTED_ENV_KEYS = (
+    HERMACHY_GUARD,
+    "TERMINAL_ENV",
+    "TERMINAL_CWD",
+    "TERMINAL_SSH_HOST",
+    "TERMINAL_SSH_USER",
+    "TERMINAL_SSH_PORT",
+    "TERMINAL_SSH_KEY",
+    "TERMINAL_SSH_PERSISTENT",
+    "TERMINAL_SYNC_REMOTE_STATE",
+)
+
+
+class SafeExecutorError(RuntimeError):
+    """The active Hermachy execution envelope is incomplete or unsafe."""
+
+
+def _source(env: Mapping[str, str] | None) -> Mapping[str, str]:
+    return os.environ if env is None else env
+
+
+def _target(env: MutableMapping[str, str] | None) -> MutableMapping[str, str]:
+    return os.environ if env is None else env
+
+
+def is_hermachy_safe_executor_requested(
+    env: Mapping[str, str] | None = None,
+) -> bool:
+    """Return whether the trusted Hermachy launcher requested safe-executor mode."""
+
+    return _source(env).get(HERMACHY_GUARD) == "1"
+
+
+def capture_hermachy_safe_executor_env(
+    env: Mapping[str, str] | None = None,
+) -> dict[str, str] | None:
+    """Snapshot the routing envelope before dotenv/config overlays can run."""
+
+    source = _source(env)
+    if not is_hermachy_safe_executor_requested(source):
+        return None
+    return {name: source[name] for name in PROTECTED_ENV_KEYS if name in source}
+
+
+def restore_hermachy_safe_executor_env(
+    snapshot: Mapping[str, str] | None,
+    env: MutableMapping[str, str] | None = None,
+) -> None:
+    """Restore a captured envelope exactly, then validate it fail-closed."""
+
+    if snapshot is None:
+        return
+    target = _target(env)
+    for name in PROTECTED_ENV_KEYS:
+        if name in snapshot:
+            target[name] = snapshot[name]
+        else:
+            target.pop(name, None)
+    validate_hermachy_safe_executor_env(target)
+
+
+def _has_control_character(value: str) -> bool:
+    return any(ord(char) < 32 or ord(char) == 127 for char in value)
+
+
+def validate_hermachy_safe_executor_env(
+    env: Mapping[str, str] | None = None,
+) -> None:
+    """Require the complete v1 execution boundary when Hermachy mode is active."""
+
+    source = _source(env)
+    if not is_hermachy_safe_executor_requested(source):
+        return
+
+    if os.name == "nt":
+        raise SafeExecutorError(
+            "Hermachy safe executor requires POSIX SSH multiplexing"
+        )
+
+    expected = {
+        "TERMINAL_ENV": "ssh",
+        "TERMINAL_SSH_PERSISTENT": "true",
+        "TERMINAL_SYNC_REMOTE_STATE": "false",
+    }
+    for name, value in expected.items():
+        if source.get(name) != value:
+            raise SafeExecutorError(
+                f"invalid Hermachy safe-executor setting: {name}"
+            )
+
+    cwd = source.get("TERMINAL_CWD", "")
+    if not cwd or _has_control_character(cwd):
+        raise SafeExecutorError(
+            "invalid Hermachy safe-executor setting: TERMINAL_CWD"
+        )
+    if not cwd.startswith("/"):
+        raise SafeExecutorError("Hermachy executor cwd must be absolute")
+
+    for name in ("TERMINAL_SSH_HOST", "TERMINAL_SSH_USER"):
+        value = source.get(name, "")
+        if (
+            not value
+            or value != value.strip()
+            or any(char.isspace() for char in value)
+            or _has_control_character(value)
+        ):
+            raise SafeExecutorError(
+                f"invalid Hermachy safe-executor setting: {name}"
+            )
+
+    try:
+        port = int(source.get("TERMINAL_SSH_PORT", ""))
+    except (TypeError, ValueError) as exc:
+        raise SafeExecutorError("invalid Hermachy SSH port") from exc
+    if not 1 <= port <= 65535:
+        raise SafeExecutorError("invalid Hermachy SSH port")
+
+    key_text = source.get("TERMINAL_SSH_KEY", "")
+    if _has_control_character(key_text):
+        raise SafeExecutorError("invalid Hermachy SSH key path")
+    key = Path(key_text)
+    if not key.is_absolute():
+        raise SafeExecutorError("Hermachy SSH key path must be absolute")
+    try:
+        key_stat = key.stat()
+    except OSError as exc:
+        raise SafeExecutorError("Hermachy SSH key is unavailable") from exc
+    if not stat.S_ISREG(key_stat.st_mode):
+        raise SafeExecutorError("Hermachy SSH key must be a regular file")
+    if hasattr(os, "getuid") and key_stat.st_uid != os.getuid():
+        raise SafeExecutorError(
+            "Hermachy SSH key must be owned by the current user"
+        )
+    if stat.S_IMODE(key_stat.st_mode) & 0o077:
+        raise SafeExecutorError(
+            "Hermachy SSH key must not be accessible to group or others"
+        )
+
+
+def overlay_hermachy_terminal_config(
+    config: Mapping[str, object],
+    env: Mapping[str, str] | None = None,
+) -> dict[str, object]:
+    """Return config whose terminal view matches the protected Hermachy envelope."""
+
+    source = _source(env)
+    result = dict(config)
+    if not is_hermachy_safe_executor_requested(source):
+        return result
+
+    validate_hermachy_safe_executor_env(source)
+    result.update(
+        {
+            "backend": "ssh",
+            "env_type": "ssh",
+            "cwd": source["TERMINAL_CWD"],
+            "ssh_host": source["TERMINAL_SSH_HOST"],
+            "ssh_user": source["TERMINAL_SSH_USER"],
+            "ssh_port": int(source["TERMINAL_SSH_PORT"]),
+            "ssh_key": source["TERMINAL_SSH_KEY"],
+            "persistent_shell": True,
+        }
+    )
+    return result
