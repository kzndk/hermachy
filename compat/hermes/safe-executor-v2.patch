@@ -0,0 +1,203 @@
+"""Fail-closed contracts for Hermachy's process-scoped executor."""
+
+from __future__ import annotations
+
+import os
+from pathlib import Path
+
+import pytest
+
+from hermes_cli.safe_executor import (
+    HERMACHY_CONTROL_VERSION,
+    PROTECTED_ENV_KEYS,
+    SafeExecutorError,
+    capture_hermachy_safe_executor_env,
+    is_hermachy_safe_executor_requested,
+    overlay_hermachy_terminal_config,
+    restore_hermachy_safe_executor_env,
+    validate_hermachy_safe_executor_env,
+)
+
+
+def _valid_env(key: Path) -> dict[str, str]:
+    key.write_text("private-key-placeholder", encoding="utf-8")
+    key.chmod(0o600)
+    return {
+        "HERMACHY_REQUIRE_SAFE_EXECUTOR": "1",
+        "TERMINAL_ENV": "ssh",
+        "TERMINAL_CWD": "/home/beta/project",
+        "TERMINAL_SSH_HOST": "omarchy.example.ts.net",
+        "TERMINAL_SSH_USER": "beta",
+        "TERMINAL_SSH_PORT": "22",
+        "TERMINAL_SSH_KEY": str(key),
+        "TERMINAL_SSH_PERSISTENT": "true",
+        "TERMINAL_SYNC_REMOTE_STATE": "false",
+    }
+
+
+def test_capability_version_is_v1():
+    assert HERMACHY_CONTROL_VERSION == "2"
+
+
+def test_inactive_environment_is_a_noop(tmp_path):
+    env = {"TERMINAL_ENV": "local"}
+
+    assert not is_hermachy_safe_executor_requested(env)
+    assert capture_hermachy_safe_executor_env(env) is None
+    assert validate_hermachy_safe_executor_env(env) is None
+    assert overlay_hermachy_terminal_config({"backend": "docker"}, env) == {
+        "backend": "docker"
+    }
+
+
+def test_valid_environment_passes_and_overlays_terminal_config(tmp_path):
+    env = _valid_env(tmp_path / "id_ed25519")
+
+    validate_hermachy_safe_executor_env(env)
+    terminal = overlay_hermachy_terminal_config(
+        {
+            "backend": "local",
+            "cwd": "/wrong",
+            "ssh_host": "wrong.example",
+            "ssh_key": "/wrong/key",
+            "timeout": 600,
+        },
+        env,
+    )
+
+    assert terminal == {
+        "backend": "ssh",
+        "env_type": "ssh",
+        "cwd": "/home/beta/project",
+        "ssh_host": "omarchy.example.ts.net",
+        "ssh_user": "beta",
+        "ssh_port": 22,
+        "ssh_key": str(tmp_path / "id_ed25519"),
+        "persistent_shell": True,
+        "timeout": 600,
+    }
+
+
+@pytest.mark.parametrize(
+    ("name", "value", "message"),
+    [
+        ("TERMINAL_ENV", "local", "TERMINAL_ENV"),
+        ("TERMINAL_SSH_PERSISTENT", "false", "TERMINAL_SSH_PERSISTENT"),
+        ("TERMINAL_SYNC_REMOTE_STATE", "true", "TERMINAL_SYNC_REMOTE_STATE"),
+        ("TERMINAL_CWD", "", "TERMINAL_CWD"),
+        ("TERMINAL_CWD", "relative/project", "cwd must be absolute"),
+        ("TERMINAL_CWD", "/home/beta\nother", "TERMINAL_CWD"),
+        ("TERMINAL_SSH_HOST", "", "TERMINAL_SSH_HOST"),
+        ("TERMINAL_SSH_HOST", "host\nother", "TERMINAL_SSH_HOST"),
+        ("TERMINAL_SSH_USER", "", "TERMINAL_SSH_USER"),
+        ("TERMINAL_SSH_PORT", "zero", "SSH port"),
+        ("TERMINAL_SSH_PORT", "0", "SSH port"),
+        ("TERMINAL_SSH_PORT", "65536", "SSH port"),
+        ("TERMINAL_SSH_KEY", "", "key path must be absolute"),
+        ("TERMINAL_SSH_KEY", "relative-key", "key path must be absolute"),
+    ],
+)
+def test_active_environment_rejects_invalid_values(tmp_path, name, value, message):
+    env = _valid_env(tmp_path / "id_ed25519")
+    env[name] = value
+
+    with pytest.raises(SafeExecutorError, match=message):
+        validate_hermachy_safe_executor_env(env)
+
+
+def test_active_environment_rejects_missing_key(tmp_path):
+    env = _valid_env(tmp_path / "id_ed25519")
+    env["TERMINAL_SSH_KEY"] = str(tmp_path / "missing")
+
+    with pytest.raises(SafeExecutorError, match="key is unavailable"):
+        validate_hermachy_safe_executor_env(env)
+
+
+def test_active_environment_rejects_non_regular_key(tmp_path):
+    env = _valid_env(tmp_path / "id_ed25519")
+    directory = tmp_path / "key-directory"
+    directory.mkdir()
+    env["TERMINAL_SSH_KEY"] = str(directory)
+
+    with pytest.raises(SafeExecutorError, match="regular file"):
+        validate_hermachy_safe_executor_env(env)
+
+
+def test_active_environment_rejects_group_or_other_key_access(tmp_path):
+    env = _valid_env(tmp_path / "id_ed25519")
+    Path(env["TERMINAL_SSH_KEY"]).chmod(0o640)
+
+    with pytest.raises(SafeExecutorError, match="group or others"):
+        validate_hermachy_safe_executor_env(env)
+
+
+def test_capture_restore_defeats_routing_overrides(tmp_path):
+    env = _valid_env(tmp_path / "id_ed25519")
+    env["UNRELATED"] = "keep"
+    snapshot = capture_hermachy_safe_executor_env(env)
+
+    assert snapshot is not None
+    assert set(snapshot) == set(PROTECTED_ENV_KEYS)
+
+    env.update(
+        {
+            "HERMACHY_REQUIRE_SAFE_EXECUTOR": "0",
+            "TERMINAL_ENV": "local",
+            "TERMINAL_CWD": "/wrong",
+            "TERMINAL_SYNC_REMOTE_STATE": "true",
+        }
+    )
+    restore_hermachy_safe_executor_env(snapshot, env)
+
+    assert env["HERMACHY_REQUIRE_SAFE_EXECUTOR"] == "1"
+    assert env["TERMINAL_ENV"] == "ssh"
+    assert env["TERMINAL_CWD"] == "/home/beta/project"
+    assert env["TERMINAL_SYNC_REMOTE_STATE"] == "false"
+    assert env["UNRELATED"] == "keep"
+    validate_hermachy_safe_executor_env(env)
+
+
+def test_restore_removes_protected_values_absent_from_snapshot(tmp_path):
+    env = _valid_env(tmp_path / "id_ed25519")
+    snapshot = capture_hermachy_safe_executor_env(env)
+    assert snapshot is not None
+    snapshot.pop("TERMINAL_SSH_USER")
+
+    with pytest.raises(SafeExecutorError, match="TERMINAL_SSH_USER"):
+        restore_hermachy_safe_executor_env(snapshot, env)
+    assert "TERMINAL_SSH_USER" not in env
+
+
+@pytest.mark.skipif(os.name == "nt", reason="POSIX-only ownership contract")
+def test_active_environment_rejects_foreign_owner_contract(tmp_path, monkeypatch):
+    env = _valid_env(tmp_path / "id_ed25519")
+    real_getuid = os.getuid
+    monkeypatch.setattr(os, "getuid", lambda: real_getuid() + 1)
+
+    with pytest.raises(SafeExecutorError, match="current user"):
+        validate_hermachy_safe_executor_env(env)
+
+
+def test_reload_env_cannot_replace_or_delete_hermachy_controls(tmp_path, monkeypatch):
+    import hermes_cli.config as config_mod
+
+    values = _valid_env(tmp_path / "id_ed25519")
+    for name, value in values.items():
+        monkeypatch.setenv(name, value)
+    monkeypatch.setattr(
+        config_mod,
+        "load_env",
+        lambda: {
+            "HERMACHY_REQUIRE_SAFE_EXECUTOR": "0",
+            "TERMINAL_ENV": "local",
+            "TERMINAL_CWD": "/wrong",
+            "TERMINAL_SYNC_REMOTE_STATE": "true",
+            "OPENAI_BASE_URL": "https://updated.example",
+        },
+    )
+
+    changed = config_mod.reload_env()
+
+    assert changed > 0
+    assert {name: os.environ.get(name) for name in values} == values
+    assert os.environ["OPENAI_BASE_URL"] == "https://updated.example"
