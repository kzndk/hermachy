diff --git a/ui-tui/src/app/omarchyThemeStore.ts b/ui-tui/src/app/omarchyThemeStore.ts
new file mode 100644
index 0000000000000000000000000000000000000000..bbcbfbb3a551193594de6a70d0581763dd3ddee2
--- /dev/null
+++ b/ui-tui/src/app/omarchyThemeStore.ts
@@ -0,0 +1,128 @@
+import { readFileSync } from 'node:fs'
+import { homedir } from 'node:os'
+import { join } from 'node:path'
+
+import { mix } from '@hermes/shared/color'
+import type { SkinColors } from '@hermes/shared/skin'
+import { atom, onMount } from 'nanostores'
+
+const paletteColor = (palette: Record<string, string>, ...names: string[]) =>
+  names.map(name => palette[name]).find(Boolean)
+
+// Omarchy's colors.toml is a flat palette. Accept both semantic names and
+// the color0–15 names used by community themes; ignore non-color settings.
+const readPalette = (source: string): SkinColors | null => {
+  const p: Record<string, string> = {}
+
+  for (const match of source.matchAll(/^\s*([a-z][a-z0-9_]*)\s*=\s*(["'])(#[0-9a-f]{6})\2\s*(?:#.*)?$/gim)) {
+    p[match[1].toLowerCase()] = match[3].toLowerCase()
+  }
+
+  const background = paletteColor(p, 'background', 'bg', 'color0')
+  const text = paletteColor(p, 'foreground', 'fg', 'color7')
+  const accent = paletteColor(p, 'accent', 'blue', 'color4')
+
+  if (!background || !text || !accent) {
+    return null
+  }
+
+  const border = p.muted ?? mix(background, text, 0.25)
+  const muted = paletteColor(p, 'dark_foreground', 'color8') ?? mix(background, text, 0.55)
+  const surface = p.lighter_background ?? mix(background, text, 0.04)
+  const selection = p.selection ?? mix(background, accent, 0.2)
+  const green = paletteColor(p, 'green', 'color2') ?? accent
+  const yellow = paletteColor(p, 'yellow', 'color3') ?? accent
+  const red = paletteColor(p, 'red', 'color1') ?? accent
+  const cyan = paletteColor(p, 'cyan', 'color6') ?? accent
+  const magenta = paletteColor(p, 'magenta', 'color5') ?? accent
+
+  return {
+    background,
+    ui_accent: accent,
+    ui_primary: accent,
+    ui_text: text,
+    ui_border: border,
+    banner_dim: muted,
+    ui_label: cyan,
+    ui_ok: green,
+    ui_warn: yellow,
+    ui_error: red,
+    ui_tool: cyan,
+    ui_thinking: muted,
+    prompt: accent,
+    shell_dollar: green,
+    session_label: muted,
+    session_border: border,
+    status_bar_bg: surface,
+    status_bar_text: text,
+    status_bar_good: green,
+    status_bar_warn: yellow,
+    status_bar_bad: red,
+    status_bar_critical: red,
+    selection_bg: selection,
+    completion_menu_bg: surface,
+    completion_menu_current_bg: selection,
+    completion_menu_meta_bg: surface,
+    completion_menu_meta_current_bg: selection,
+    diff_added: mix(background, green, 0.15),
+    diff_removed: mix(background, red, 0.15),
+    diff_added_word: mix(background, green, 0.3),
+    diff_removed_word: mix(background, red, 0.3),
+    syntax_string: green,
+    syntax_number: yellow,
+    syntax_keyword: magenta,
+    syntax_comment: muted
+  }
+}
+
+const createOmarchyColors = (path: string | null) => {
+  const colors = atom<SkinColors | null>(null)
+
+  if (!path) {
+    return colors
+  }
+
+  let previous = ''
+
+  const refresh = () => {
+    try {
+      const source = readFileSync(path, 'utf8')
+
+      if (source === previous) {
+        return
+      }
+
+      const palette = readPalette(source)
+
+      // A theme switch can briefly remove or partially write the palette.
+      // Keep the last valid colors until the replacement is ready.
+      if (palette) {
+        previous = source
+        colors.set(palette)
+      }
+    } catch {
+      // Omarchy is optional; normal Hermes skins remain the fallback.
+    }
+  }
+
+  refresh()
+  onMount(colors, () => {
+    refresh()
+    // Poll the pathname, not an inode: Omarchy replaces the current theme
+    // directory atomically, and some installations use a symlink instead.
+    const timer = setInterval(refresh, 1000)
+    timer.unref()
+
+    return () => clearInterval(timer)
+  })
+
+  return colors
+}
+
+// The Hermachy launcher already supplies HERMACHY_REQUEST. Keep this local
+// integration out of ordinary Hermes sessions and off the remote gateway.
+export const $omarchyColors = createOmarchyColors(
+  process.env.HERMACHY_REQUEST
+    ? join(process.env.XDG_STATE_HOME || join(homedir(), '.local/state'), 'omarchy/current/theme/colors.toml')
+    : null
+)
