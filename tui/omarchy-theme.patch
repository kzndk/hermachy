+import { mkdirSync, mkdtempSync, renameSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+
+import { afterEach, beforeEach, expect, it, vi } from 'vitest'
+
+const dark = `
+background = "#0B0C16"
+foreground = "#ddf7ff"
+accent = "#82FB9C"
+cyan = "#7cf8f7"
+selection = "#1f253a"
+lighter_background = "#151828"
+`
+
+// Community palettes can use ANSI names and single quotes.
+const light = `
+color0 = '#fafafa'
+color7 = '#202020'
+color4 = '#164ba0' # accent
+color8 = '#606060'
+`
+
+let root: string
+let themeDir: string
+
+let cleanup = () => {}
+
+beforeEach(() => {
+  vi.resetModules()
+  root = mkdtempSync(join(tmpdir(), 'hermachy-omarchy-theme-'))
+  themeDir = join(root, 'omarchy/current/theme')
+  mkdirSync(themeDir, { recursive: true })
+  writeFileSync(join(themeDir, 'colors.toml'), dark)
+  vi.stubEnv('XDG_STATE_HOME', root)
+  vi.stubEnv('HERMES_HOME', join(root, 'hermes'))
+  vi.stubEnv('HERMACHY_REQUEST', 'local-session')
+  vi.stubEnv('COLORTERM', 'truecolor')
+})
+
+afterEach(() => {
+  cleanup()
+
+  cleanup = () => {}
+  vi.unstubAllEnvs()
+  rmSync(root, { force: true, recursive: true })
+})
+
+it('follows local palette replacements without changing the active session or accepting remote colors', async () => {
+  // A remote mode pin or stale boot background cannot override Omarchy.
+  vi.stubEnv('HERMES_TUI_THEME', 'light')
+  vi.stubEnv('HERMES_TUI_BACKGROUND', '#ffffff')
+  const { getUiState, patchUiState } = await import('../app/uiStore.js')
+  const { createGatewayEventHandler } = await import('../app/createGatewayEventHandler.js')
+  const { $omarchyColors } = await import('../app/omarchyThemeStore.js')
+  const { cleanStores } = await import('nanostores')
+  cleanup = () => cleanStores($omarchyColors)
+
+  // The first frame already matches the desktop, before gateway.ready.
+  expect(getUiState().theme.color.primary).toBe('#82fb9c')
+  expect(getUiState().theme.color.text).toBe('#ddf7ff')
+  patchUiState({ busy: true, sid: 'keep-this-session', sessionTitle: 'In progress', status: 'running…' })
+  const { theme: _theme, ...before } = getUiState()
+  const rpc = vi.fn()
+  const setInput = vi.fn()
+  const newSession = vi.fn()
+
+  const handle = createGatewayEventHandler({
+    composer: { setInput },
+    gateway: { rpc },
+    session: { newSession },
+    submission: {},
+    system: {},
+    transcript: {},
+    voice: {}
+  } as any)
+
+  const remoteSkin = {
+    branding: { agent_name: 'Hermachy', prompt_symbol: '>' },
+    colors: { background: '#000000', ui_primary: '#ffbf00', ui_text: '#ffbf00' },
+    light_colors: { ui_primary: '#990000' }
+  }
+
+  handle({ type: 'skin.changed', payload: remoteSkin })
+  expect(getUiState().theme.brand.name).toBe('Hermachy')
+  expect(getUiState().theme.color.primary).toBe('#82fb9c')
+
+  // Omarchy replaces the directory, not just the file's contents.
+  renameSync(themeDir, join(root, 'old-theme'))
+  mkdirSync(themeDir)
+  writeFileSync(join(themeDir, 'colors.toml'), light)
+  await vi.waitFor(() => expect(getUiState().theme.color.primary).toBe('#164ba0'), { timeout: 3000 })
+  expect(getUiState().theme.color.text).toBe('#202020')
+  expect($omarchyColors.get()?.background).toBe('#fafafa')
+  handle({ type: 'skin.changed', payload: remoteSkin })
+  expect(getUiState().theme.color.primary).toBe('#164ba0')
+
+  // A transient incomplete palette must not revert to the remote skin.
+  writeFileSync(join(themeDir, 'colors.toml'), 'background = "#0B0C16"\n')
+  const valid = $omarchyColors.get()
+  await new Promise(resolve => setTimeout(resolve, 1200))
+  expect($omarchyColors.get()).toBe(valid)
+  writeFileSync(join(themeDir, 'colors.toml'), dark)
+  await vi.waitFor(() => expect(getUiState().theme.color.primary).toBe('#82fb9c'), { timeout: 3000 })
+  const { theme: updated, ...after } = getUiState()
+  expect(after).toEqual(before)
+  expect(updated.brand.name).toBe('Hermachy')
+  expect(rpc).not.toHaveBeenCalled()
+  expect(setInput).not.toHaveBeenCalled()
+  expect(newSession).not.toHaveBeenCalled()
+}, 15000)
+
+it('leaves ordinary Hermes launches on their gateway skin even when Omarchy is installed', async () => {
+  vi.stubEnv('HERMACHY_REQUEST', '')
+  const { $omarchyColors } = await import('../app/omarchyThemeStore.js')
+  expect($omarchyColors.get()).toBeNull()
+})
